# Supabase (Phase 1 — required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the client, never prefix with NEXT_PUBLIC_.
# Required for audit logging (docs/SECURITY.md); without it, audit writes are silently skipped.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app (Phase 1 — required for magic-link email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers (Phase 2+ — Prompt Builder / Improver / Tester / Prompt Scout)
ANTHROPIC_API_KEY=
# Only needed if your Anthropic API key is org/workspace-linked — the API will
# tell you with a 400 "anthropic-workspace-id is required..." error if so.
ANTHROPIC_WORKSPACE_ID=
# Required for semantic/natural-language search (Phase 3) — used for embeddings
# (text-embedding-3-small) even though the AI provider used for generation is
# Anthropic. Without it, search falls back to keyword matching automatically.
OPENAI_API_KEY=

# Google OAuth (Phase 5+ — Sheets / Drive integration, optional social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Trigger.dev (Phase 4+ — Prompt Scout weekly scheduler)
# These four are NOT read by the Next.js app — they belong to the
# `weekly-prompt-scout` task and must be set in the Trigger.dev project's own
# dashboard (Environment Variables), not here. Listed for discoverability.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
# The single owning user's auth.users id (single-tenant app — see
# docs/AGENT_ARCHITECTURE.md). The scheduled job has no session to derive
# this from, so it must be set explicitly.
SCOUT_OWNER_USER_ID=
# IANA timezone for the Sunday 02:00 weekly run. Defaults to UTC if unset.
# Note: Trigger.dev's schedule validator rejected "Asia/Kolkata" at deploy time
# despite it being a standard IANA zone — check the supported list at
# https://cloud.trigger.dev/timezones before setting this.
SCOUT_TIMEZONE=
