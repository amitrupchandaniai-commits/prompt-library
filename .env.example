# Supabase (Phase 1 — required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the client, never prefix with NEXT_PUBLIC_.
# Required for audit logging (docs/SECURITY.md); without it, audit writes are silently skipped.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app (Phase 1 — required for magic-link email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers (Phase 2+ — Prompt Builder / Improver / Tester / Prompt Scout)
ANTHROPIC_API_KEY=
# Only needed if your Anthropic API key is org/workspace-linked — the API will
# tell you with a 400 "anthropic-workspace-id is required..." error if so.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=

# Google OAuth (Phase 5+ — Sheets / Drive integration, optional social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Trigger.dev (Phase 4+ — Prompt Scout weekly scheduler)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
